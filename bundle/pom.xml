<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.eventb</groupId>
		<artifactId>parent</artifactId>
		<version>3.10.0-SNAPSHOT</version>
		<relativePath>../rodincore/org.eventb.parent/pom.xml</relativePath>
	</parent>

	<groupId>org.eventb.rossi</groupId>
	<artifactId>bundle</artifactId>
	<version>3.10.0-SNAPSHOT</version>
	<packaging>eclipse-repository</packaging>

	<name>Rodin Bundle (eventb-rossi)</name>

	<properties>
		<!-- Appended to the archive name, following the Rodin-Bundles scheme. -->
		<bundle-suffix>rossi</bundle-suffix>
	</properties>

	<!--
	    ProB is not built in this reactor, so its update site joins the target
	    platform, and GEF with it: de.prob.ui requires org.eclipse.gef
	    [3.11.0,4.0.0), which the Rodin parent's repositories (the Eclipse
	    platform and the handbook) do not carry.  Declared here rather than in
	    the parent so the rodincore fork stays untouched: Tycho resolves a
	    target platform per module, and this is the module that assembles the
	    product.
	-->
	<repositories>
		<repository>
			<id>prob</id>
			<layout>p2</layout>
			<url>https://stups.hhu-hosting.de/rodin/prob1/release/</url>
		</repository>
		<repository>
			<!--
			    GEF Classic, pinned: the legacy GEF 3.x site stops at
			    org.eclipse.gef 3.10 and would not satisfy the range.
			    3.29.0 carries org.eclipse.gef 3.26.100.
			-->
			<id>gef-classic</id>
			<layout>p2</layout>
			<url>https://download.eclipse.org/tools/gef/classic/release/3.29.0/</url>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<executions>
					<execution>
						<id>materialize-products</id>
						<goals>
							<goal>materialize-products</goal>
						</goals>
					</execution>
					<execution>
						<id>archive-products</id>
						<goals>
							<goal>archive-products</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<formats>
						<linux>tar.gz</linux>
						<macosx>tar.gz</macosx>
						<win32>zip</win32>
					</formats>
					<products>
						<product>
							<id>org.eventb.rossi.product</id>
							<archiveFileName>rodin-${unqualifiedVersion}.${buildQualifier}-${bundle-suffix}</archiveFileName>
							<rootFolder>rodin</rootFolder>
						</product>
					</products>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
